# LSO100 train-board hourly refresh.
#
# Install:
#   crontab -e
#   (paste the line below, edit the absolute path, save)
#
# Required env (set in /etc/profile.d/lkus-lso.sh or systemd EnvironmentFile):
#   MYSQL_SECRET_NAME=collector/mysql       # AWS Secrets Manager secret name
#   AWS_REGION=us-east-1
#   IEHR_HOST=...                            # optional per-DB host override
#   OPEMPEFFICIENCY_HOST=...                 # optional per-DB host override
#   GITHUB_TOKEN=ghp_xxx                     # repo-scope PAT
#   GITHUB_REPO=xiangyuzeng/lkus-lso-train-dashboard
#   GITHUB_BRANCH=main
#   GITHUB_FILE_PATH=public/data.json
#
# Mode A — pymysql + Secrets Manager (PRIMARY):
0 * * * * cd /opt/lkus-lso-train-dashboard && ./refresh.sh >> logs/cron.log 2>&1

# Mode C — Claude Code agent fallback (uncomment if Mode A is not viable):
# 0 * * * * cd /opt/lkus-lso-train-dashboard && claude --dangerously-skip-permissions -p "$(cat refresh_prompt.md)" >> logs/cron.log 2>&1
